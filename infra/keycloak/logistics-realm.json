{
  "realm": "logistics",
  "enabled": true,
  "displayName": "Logistics Platform",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Own shipments and processing tasks"
      },
      {
        "name": "ADMIN",
        "description": "All shipments and administration"
      },
      {
        "name": "COURIER_READER",
        "description": "Service access to available couriers"
      }
    ]
  },
  "clients": [
    {
      "clientId": "logistics-cli",
      "name": "Local API examples",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "logistics-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "logistics-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "logistics-web",
      "name": "Logistics Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "logistics-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "logistics-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "shipment-processing-service",
      "name": "Shipment processing service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROCESSING_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "logistics-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "logistics-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "rinat",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rinat",
      "lastName": "Demo",
      "email": "rinat@example.test",
      "requiredActions": [],
      "realmRoles": [
        "USER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "sofia",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sofia",
      "lastName": "Demo",
      "email": "sofia@example.test",
      "requiredActions": [],
      "realmRoles": [
        "USER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "admin",
      "lastName": "Demo",
      "email": "admin@example.test",
      "requiredActions": [],
      "realmRoles": [
        "USER",
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-shipment-processing-service",
      "enabled": true,
      "serviceAccountClientId": "shipment-processing-service",
      "realmRoles": [
        "COURIER_READER"
      ]
    }
  ]
}
